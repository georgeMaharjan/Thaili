    "ignore": "\\b(?:failed|declined|unsuccessful|pending|cancelled|canceled|scheduled|processing)\\b|\\b(?:payment|money|transfer)\\s+request\\b|\\b(?:request|requested)\\s+(?:for\\s+)?(?:money|payment)\\b|\\b(?:will be|to be)\\s+(?:debited|credited|deducted)\\b|\\b(?:is due|due date|reminder|pay now|please pay|up to|win|offer|earn cashback)\\b|(?:OTP|one[- ]?time password|verification code|passcode)\\W{0,8}(?:is\\W*)?[0-9]{4,8}\\b|\\b[0-9]{4,8}\\s+(?:is your\\s+)?(?:OTP|verification code)\\b|असफल|प्रक्रियामा",
    "debit": "\\b(?:debited|deducted|paid|sent|withdrawn|spent|charged|purchased)\\b|\\b(?:payment|purchase|withdrawal|bill payment|wallet transfer)\\s+(?:was\\s+|is\\s+)?(?:successful|completed|success)\\b|\\b(?:made|completed)\\s+(?:a\\s+)?payment\\b|\\b(?:transfer|your\\s+transaction)\\s+of\\b[^\\n]*?\\b(?:is|was|has been)\\s+(?:successfully\\s+)?(?:successful|completed)\\b|\\b(?:successfully\\s+(?:paid|sent|transferred)|transferred\\s+(?:to|from your))\\b|\\bdebit\\s+(?:alert|transaction)\\b|\\bdebit\\s*[:\\n]|\\b(?:transaction\\s*type|type)\\s*[:=-]\\s*(?:dr|debit)\\b|भुक्तानी\\s*(?:भएको|भयो|सफल)|कटौती|खर्च\\s*भयो|पठाइएको",
    "credit": "\\b(?:credited|received|deposited|refunded)\\b|\\b(?:funds?|money|balance)\\s+(?:has been\\s+|is\\s+|was\\s+)?(?:added|loaded)\\b|\\b(?:added|loaded)\\s+to\\s+your\\s+(?:wallet|account|balance)\\b|\\bloaded\\b[^\\n]*\\b(?:your|wallet)\\b|\\b(?:has been|was)\\s+loaded\\s+with\\b|\\b(?:refund|cashback|deposit|top[- ]?up|load)\\s+(?:successful|completed|received)\\b|\\bcredit\\s+(?:alert|transaction)\\b|\\bcredit\\s*[:\\n]|\\b(?:transaction\\s*type|type)\\s*[:=-]\\s*(?:cr|credit)\\b|जम्मा\\s*(?:भएको|भयो|गरिएको)|प्राप्त"
